{
  "name": "crocodile",
  "private": true,
  "description": "Crocodile: peer-to-peer, end-to-end encrypted voice, video and text communicator",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:directory": "pnpm --filter @crocodile/directory dev",
    "dev:coordinator": "pnpm --filter @crocodile/coordinator dev",
    "dev:desktop": "pnpm --filter @crocodile/desktop dev",
    "build": "pnpm -r --filter ./apps/** --filter @crocodile/coordinator build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "qa:env": "tsx tests/qa/env.ts",
    "qa:app": "node tests/qa/app.mjs",
    "qa:showcase": "tsx tests/electron/showcase.ts",
    "qa:smoke": "tsx tests/electron/smoke.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.6.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.0.0"
  }
}
