# Public domain of the directory (and later the website), e.g. crocodilechat.com.
# The coordination server is reachable at coord.<domain>.
CROC_DOMAIN=
# Public IPv4 of this machine, advertised for the relay.
CROC_RELAY_IP=
# Optional
# Where the coordinator's WebSocket port listens. Keep 127.0.0.1 when the
# reverse proxy runs on the host; when it runs in a container, use the gateway
# of the proxy's Docker network (see README.md), never a public address.
#CROC_COORD_HOST=127.0.0.1
CROC_COORD_NAME=Crocodile main
CROC_REGION=eu-central
CROC_RELAY=on
CROC_RELAY_MAX_USERS=25
CROC_MAILBOX=on
CROC_MAILBOX_DAYS=3
